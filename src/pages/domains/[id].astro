---
import '../../styles/global.css'
import { DomainDetail } from '../../components/DomainDetail'
import { getDomainOrThrow } from '../../server/domain/get-domain'
import { diff } from '../../server/reconcile/diff'
import { NotFoundError } from '../../server/errors'
import { getCloudflareDefaultPublicIp } from '../../server/settings/dns-providers'
import type { DomainDetailResponse, DomainDetailView } from '../../lib/domain-types'

const { id } = Astro.params

// Datos iniciales para la isla (primer paint = SSR). Tras montar, la isla se refresca en
// sitio contra GET /api/domains/:id sin recargar.
let initial: DomainDetailResponse | null = null

try {
    const domain = await getDomainOrThrow(id ?? '')
    const status = await diff(domain)

    const view: DomainDetailView = {
        id: domain.id,
        hostname: domain.hostname,
        visibility: domain.visibility,
        forwardScheme: domain.forwardScheme,
        forwardHost: domain.forwardHost,
        forwardPort: domain.forwardPort,
        npmOptions: domain.npmOptions,
        customLocations: domain.customLocations,
        advancedConfig: domain.advancedConfig,
        sslMode: domain.sslMode,
        certificateId: domain.certificateId,
        cfRecordType: domain.cfRecordType,
        cfContent: domain.cfContent,
        cfProxied: domain.cfProxied,
        cfZoneId: domain.cfZoneId,
        cfZoneName: domain.cfZoneName,
        npmProxyId: domain.npmProxyId,
        cloudflareRecordId: domain.cloudflareRecordId,
        mikrotikDnsId: domain.mikrotikDnsId,
        reconcileState: domain.reconcileState,
        lastReconciledAt: domain.lastReconciledAt?.toISOString() ?? null,
        createdAt: domain.createdAt.toISOString(),
        updatedAt: domain.updatedAt.toISOString(),
    }

    initial = {
        domain: view,
        status,
        publicIp: await getCloudflareDefaultPublicIp(),
    }
} catch (error) {
    if (error instanceof NotFoundError) {
        Astro.response.status = 404
    } else {
        throw error
    }
}
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{initial ? `${initial.domain.hostname} · proxy-control` : 'Dominio no encontrado'}</title>
    </head>
    <body>
        {
            initial ? (
                <DomainDetail client:load initial={initial} />
            ) : (
                <div class="mx-auto max-w-3xl px-4 py-8">
                    <a
                        href="/"
                        class="mb-6 inline-flex items-center gap-1 text-sm text-[var(--color-muted)] hover:text-[var(--color-text)]"
                    >
                        ← Dominios
                    </a>
                    <div
                        class="rounded-[var(--radius-card)] border px-6 py-16 text-center"
                        style={{ borderColor: 'var(--color-border)', backgroundColor: 'var(--color-surface)' }}
                    >
                        <p class="text-base font-medium">Dominio no encontrado</p>
                        <p class="mt-1 text-sm text-[var(--color-muted)]">
                            No existe un dominio con ese id, o fue eliminado.
                        </p>
                    </div>
                </div>
            )
        }
    </body>
</html>
