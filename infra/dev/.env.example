# Variables del stack de DEV (docker compose -f infra/dev/compose.yml). Los secretos de
# la app (NPM/Cloudflare/Mikrotik/auth) se leen del `.env` de la RAÍZ, no de aquí.
# Copia a infra/dev/.env si quieres cambiar puertos o credenciales de Postgres.

# Postgres del stack
POSTGRES_USER=proxy_control
POSTGRES_PASSWORD=proxy_control
POSTGRES_DB=proxy_control
POSTGRES_PORT=15432

# Puertos publicados
APP_PORT=4321
PROMETHEUS_PORT=19090
LOKI_PORT=13100
ALLOY_PORT=12345
GRAFANA_PORT=13000

# Alertmanager (opcional en dev)
PROXY_CONTROL_DISCORD_WEBHOOK_URL=

# Descubrimiento por labels de Docker (off por defecto; el socket ya se monta RO en compose).
DOCKER_LABELS_ENABLED=false
DOCKER_LABEL_PREFIX=proxy-control
