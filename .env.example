# ─────────────────────────────────────────────────────────────
# proxy-control — plantilla de variables de entorno.
# Copia a `.env` (dev) y rellena. NUNCA commitees el `.env` real.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=4321

# Base de datos (Postgres)
#  dev : Postgres local directo (sin pgbouncer)      → postgres:5432
#  prod: PgBouncer del core (transaction mode)       → pgbouncer:6432
# search_path fija el esquema propio de la app.
DATABASE_URL=postgresql://proxy_control:changeme@localhost:5432/proxy_control?options=-c%20search_path%3Dproxy_control
# Solo prod: conexión DIRECTA a Postgres para migraciones (bypass del pooler).
# MIGRATION_DATABASE_URL=postgresql://proxy_control:changeme@postgres:5432/proxy_control?options=-c%20search_path%3Dproxy_control

# Nginx Proxy Manager (el del core / pi-infra)
NPM_BASE_URL=http://nginx-proxy-manager:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme

# ── Proveedores DNS (Cloudflare / Mikrotik) — LEGACY / opcional ──
# La config de proveedores DNS vive ahora en la DB y se edita desde el panel web
# (Ajustes → Proveedores DNS); los secretos se guardan cifrados. Estas variables son
# OPCIONALES: si están presentes en el PRIMER arranque, se usan para crear (seed) los
# proveedores Cloudflare y Mikrotik iniciales. Configurados ya en el panel, puedes borrarlas.
# Cloudflare es multizona: basta el token (las zonas se cargan y se eligen por dominio);
# CLOUDFLARE_ZONE_ID solo actúa como zona por defecto del seed.
# CLOUDFLARE_API_TOKEN=cf_token_with_zone_dns_edit
# CLOUDFLARE_ZONE_ID=zone_id_de_negri_es
# PUBLIC_IP=203.0.113.10                # IP por defecto de los registros A
# MIKROTIK_BASE_URL=https://192.168.88.1
# MIKROTIK_USER=proxy-control
# MIKROTIK_PASSWORD=changeme
# MIKROTIK_TLS_INSECURE=false           # true si el router usa cert self-signed
# NPM_INTERNAL_IP=192.168.1.10          # destino de las entradas DNS privadas del Mikrotik

# Auth del panel
AUTH_ENABLED=true
AUTH_USER=admin
# Hash Argon2 de la contraseña (generar con el script de auth; no la contraseña en claro).
AUTH_PASSWORD_HASH=
# Secreto para firmar la cookie de sesión (cadena larga y aleatoria).
SESSION_SECRET=changeme_genera_un_secreto_largo

# Clave para CIFRAR los secretos de proveedores DNS en la DB (AES-256-GCM). OBLIGATORIA.
# Cualquier passphrase larga (≥16). Si la cambias, los secretos ya guardados dejarán de
# descifrarse (habría que re-introducirlos en el panel).
SETTINGS_KEY=changeme_genera_una_clave_larga
